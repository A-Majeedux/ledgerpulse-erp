# Copy this file to ".env" (same folder) and put in your own values.
# ".env" holds secrets and is ignored by Git - never commit it.

# Your PostgreSQL / Neon connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require

# A long random string that signs the login cookie. Anyone who knows it can
# forge a login, so use a fresh one per installation. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# "production" = SECRET_KEY is mandatory and the login cookie is only sent over HTTPS.
FLASK_ENV=development

# "python3 app.py" turns Flask's debugger ON unless this says false. The debugger
# must never be reachable by other people, so set it to false on any machine
# that is not just your own computer.
FLASK_DEBUG=true

# Only for "python3 test_workflows.py": a PostgreSQL server where the tests may
# create, and afterwards delete, their OWN empty scratch database. They never
# touch DATABASE_URL or any database that already exists.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/postgres
